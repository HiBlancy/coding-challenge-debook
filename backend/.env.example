# Copia este archivo a `.env` antes de arrancar (`cp .env.example .env`)
PORT=3000

# Base de datos (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=debook
DB_PASSWORD=debook
DB_NAME=debook

# En desarrollo la app crea el schema automáticamente (TypeORM synchronize).
# En un proyecto real usarías migraciones — puedes mejorarlo si quieres.
DB_SYNCHRONIZE=true
